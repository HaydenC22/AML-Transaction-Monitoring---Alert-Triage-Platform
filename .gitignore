# Environment / secrets
.env
.env.local
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/profiles/.user.yml

# Great Expectations -- gx/ is fully regenerated by build_and_run_suites.py on
# every run (the Python functions are the source of truth, not the persisted
# JSON/YAML); committing it caused the datasource config to clobber itself
# whenever --layer raw and --layer marts ran as separate processes.
great_expectations/gx/

# Airflow
airflow/logs/
airflow/airflow.db
airflow/airflow-webserver.pid

# Data
data/raw/*
!data/raw/.gitkeep

# Detection reports (generated, keep only what's explicitly committed under docs/metrics)
detection/evaluation/reports/*
!detection/evaluation/reports/.gitkeep

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/tsconfig.tsbuildinfo

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docker
*.log
