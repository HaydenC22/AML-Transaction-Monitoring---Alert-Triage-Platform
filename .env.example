# Copy to .env and fill in for local docker-compose use.
# No real secrets belong in this file or in git history.

# --- pg-airflow: Airflow's own metadata database ---
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow

# --- pg-warehouse: the AML analytics warehouse (raw/staging_marts/detection/app schemas) ---
WAREHOUSE_POSTGRES_USER=aml
WAREHOUSE_POSTGRES_PASSWORD=aml
WAREHOUSE_POSTGRES_DB=aml_warehouse
WAREHOUSE_POSTGRES_HOST=pg-warehouse
WAREHOUSE_POSTGRES_PORT=5432

# --- Airflow core ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=change-me-locally
AIRFLOW_UID=50000

# --- Optional failure alerting ---
# Free Slack or Discord incoming webhook URL. Leave blank to fall back to structured log alerting.
SLACK_WEBHOOK_URL=

# --- FastAPI ---
API_DATABASE_URL=postgresql://aml:aml@pg-warehouse:5432/aml_warehouse
API_CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000

# --- Hosted demo (deployment only, set as a GitHub Actions secret + Render env var, never committed) ---
# Free-tier Postgres from https://neon.tech, used only by the sync-demo GitHub Action and the deployed API.
NEON_DATABASE_URL=

# No Kaggle account is needed to run this project: scripts/generate_paysim_sample.py
# generates a schema-compatible synthetic dataset locally (see ADR-0004). Anyone who
# wants to use the real Kaggle PaySim CSV instead can drop it into data/raw/ --
# scripts/load_raw_to_warehouse.py prefers data/raw/*.csv over the committed sample
# automatically, no extra config needed.
